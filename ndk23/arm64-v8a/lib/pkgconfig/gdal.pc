CONFIG_VERSION=3.10.3
CONFIG_INST_PREFIX=D:/Github/AndroidNativeKit/ndk23/arm64-v8a
CONFIG_INST_LIBS=-LD:/Github/AndroidNativeKit/ndk23/arm64-v8a/lib -lgdal
CONFIG_INST_CFLAGS=-ID:/Github/AndroidNativeKit/ndk23/arm64-v8a/include
CONFIG_INST_DATA=D:/Github/AndroidNativeKit/ndk23/arm64-v8a/share/gdal
prefix=${CONFIG_INST_PREFIX}
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${exec_prefix}/include
datadir=${CONFIG_INST_DATA}

Name: libgdal
Description: Geospatial Data Abstraction Library
Version: ${CONFIG_VERSION}
Libs: ${CONFIG_INST_LIBS}
Libs.private: -LD:/Github/AndroidNativeKit/ndk23/arm64-v8a/lib -lssl -lcrypto -ltiff -ljpeg -lpng -lgiflib -lwebp -lz -lbasisu -lzstd -lm -lsqlite3 -lexpat -lxml2 -lgeos_c -lcurl -lproj -pthread -lc++
Cflags: ${CONFIG_INST_CFLAGS}
